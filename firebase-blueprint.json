{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated admin or shop owner account linked via verified Google/Gmail login.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the signed-in user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Gmail address.",
          "minLength": 3,
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "Display name from Google account.",
          "minLength": 0,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin", "shop"],
          "description": "Account role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Explicit registry of system administrators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "ShopProfile": {
      "title": "ShopProfile",
      "description": "Auto spare-parts shop registered with Gmail and managed by admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 0,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "district": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "whatsapp": {
          "type": "string",
          "minLength": 7,
          "maxLength": 32
        },
        "telegramChatId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "pin": {
          "type": "string",
          "minLength": 4,
          "maxLength": 12
        },
        "tariff": {
          "type": "string",
          "enum": ["Test", "Bazis 25 AZN", "VIP 40 AZN"]
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "status": {
          "type": "string",
          "enum": ["Aktiv", "Deaktiv"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "whatsapp", "pin", "tariff", "expiresAt", "status", "createdAt", "updatedAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application settings managed by admin.",
      "type": "object",
      "properties": {
        "adminWhatsapp": {
          "type": "string",
          "minLength": 7,
          "maxLength": 32
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["adminWhatsapp", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles for signed-in admin and shop owners."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin role documents."
    },
    "/shops/{shopId}": {
      "schema": { "$ref": "#/entities/ShopProfile" },
      "description": "Registered shops owned by Gmail accounts or created by admin."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global contact and operational settings."
    }
  }
}
